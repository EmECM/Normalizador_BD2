@page "/"
@using Normalizador.Core.Modelos
@model Normalizador.Web.Pages.AnalizarModel
@{
    ViewData["Title"] = "Normalizador Automatizado";
}

<div class="contenedor">

    <div class="encabezado">
        <h1>DB ADMIN II - NORMALIZACIÓN AUTOMATIZADA</h1>
        <p>Proyecto 1 | Análisis y normalización de bases de datos</p>
    </div>

    <!-- 1. Entrada de datos -->
    <div class="seccion">
        <h2>1. Entrada de datos</h2>

        <p>
            Carga un archivo SQL para analizar y normalizar
            las tablas de tu base de datos.
        </p>

        <div class="mensaje @(Model.ConexionOk ? "ok" : "error")">
            Conexión a SQL Server: @Model.EstadoConexion
        </div>

        <p>Seleccione el archivo SQL de su base de datos:</p>

        <form method="post" enctype="multipart/form-data">
            <input type="file" asp-for="ArchivoSql" accept=".sql" />
            <br />
            <button type="submit" class="boton">Analizar estructura y evaluar prerrequisitos</button>
        </form>
    </div>

    @if (Model.MensajeError != null)
    {
        <div class="seccion">
            <div class="mensaje error">@Model.MensajeError</div>
        </div>
    }

    @if (Model.Resultado != null)
    {
        if (!Model.Resultado.ScriptValido)
        {
            <div class="seccion">
                <h2>Errores en el script</h2>
                <div class="mensaje error">
                    <ul>
                        @foreach (var error in Model.Resultado.Errores)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            </div>
        }
        else
        {
            var totalColumnas = Model.Resultado.Tablas.Sum(t => t.Columnas.Count);
            var totalRelaciones = Model.Resultado.Tablas.Sum(t => t.ClavesForaneas.Count);

            <!-- 2. Resumen de la lectura -->
            <div class="seccion">
                <h2>2. Resumen de la lectura</h2>

                <div class="mensaje ok">Archivo analizado correctamente.</div>

                <div class="resumen">
                    <div class="dato">
                        Tablas encontradas
                        <strong>@Model.Resultado.Tablas.Count</strong>
                    </div>
                    <div class="dato">
                        Columnas identificadas
                        <strong>@totalColumnas</strong>
                    </div>
                    <div class="dato">
                        Relaciones encontradas
                        <strong>@totalRelaciones</strong>
                    </div>
                </div>
            </div>

            <!-- Barra de pestañas por fase -->
            <div class="pestanas-nav">
                <button type="button" class="pestana-btn activa" onclick="mostrarPestana('tab-originales', this)">
                    3. Tablas Originales
                </button>
                <button type="button" class="pestana-btn" onclick="mostrarPestana('tab-prerrequisitos', this)">
                    4. Prerrequisitos @(Model.Correccion != null ? "(Corregidos)" : "")
                </button>
                @if (Model.PrimeraFormaNormal != null)
                {
                    <button type="button" class="pestana-btn" onclick="mostrarPestana('tab-1fn', this)">
                        5. Primera Forma Normal (1FN)
                    </button>
                    <button type="button" class="pestana-btn" onclick="mostrarPestana('tab-2fn', this)">
                        6. Segunda Forma Normal (2FN)
                    </button>
                    <button type="button" class="pestana-btn" onclick="mostrarPestana('tab-3fn', this)">
                        7. Tercera Forma Normal (3FN)
                    </button>
                    @if (Model.TerceraFormaNormal != null)
                    {
                        <button type="button" class="pestana-btn" onclick="mostrarPestana('tab-er', this)">
                            8. Diagrama E-R
                        </button>
                    }
                }
            </div>

            <!-- PESTAÑA: Tablas originales -->
            <div id="tab-originales" class="seccion pestana-panel activa">
                <h2>3. Tablas originales</h2>

                <partial name="_ListadoTablas" model="Model.Resultado.Tablas" />
            </div>

            <!-- PESTAÑA: Prerrequisitos y corrección automática -->
            <div id="tab-prerrequisitos" class="seccion pestana-panel">
                <h2>4. Informe de prerrequisitos</h2>

                <partial name="_TablaInforme" model="Model.Resultado.Resultados" />

                @if (Model.Resultado.PuedeContinuar)
                {
                    <div class="mensaje ok" style="margin-top:15px;">
                        Los prerrequisitos se cumplen: se puede continuar con la revisión de formas normales.
                    </div>
                }
                else if (Model.Correccion != null)
                {
                    <div class="mensaje error" style="margin-top:15px;">
                        Hay prerrequisitos que no se cumplen en las tablas originales. Más abajo se muestra la corrección automática aplicada.
                    </div>
                }
                else
                {
                    <div class="mensaje error" style="margin-top:15px;">
                        Hay prerrequisitos que no se cumplen: corrige las filas en rojo antes de continuar.
                    </div>
                }

                @if (Model.Correccion != null)
                {
                    <hr style="margin: 25px 0;" />
                    <h2>Corrección automática de prerrequisitos</h2>

                    @if (Model.Correccion.HuboCambios)
                    {
                        <div class="mensaje ok">
                            Se aplicaron @Model.Correccion.Cambios.Count modificación(es) para que las tablas cumplan los prerrequisitos.
                        </div>

                        <h3>Cambios realizados</h3>
                        <div class="tabla-contenedor">
                            <table class="tabla">
                                <thead>
                                    <tr>
                                        <th>Tabla</th>
                                        <th>Prerrequisito</th>
                                        <th>Modificación</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cambio in Model.Correccion.Cambios)
                                    {
                                        <tr>
                                            <td>@cambio.Tabla</td>
                                            <td>@cambio.Regla</td>
                                            <td>@cambio.Descripcion</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (Model.Correccion.AnalisisCorregido != null)
                        {
                            <h3>Tablas corregidas</h3>
                            <partial name="_ListadoTablas" model="Model.Correccion.AnalisisCorregido.Tablas" />

                            <h3>Informe de prerrequisitos después de la corrección</h3>
                            <partial name="_TablaInforme" model="Model.Correccion.AnalisisCorregido.Resultados" />

                            if (Model.Correccion.AnalisisCorregido.PuedeContinuar)
                            {
                                <div class="mensaje ok" style="margin-top:15px;">
                                    Las tablas corregidas cumplen los prerrequisitos: puedes pasar a la pestaña de Primera Forma Normal (1FN).
                                </div>
                            }
                            else
                            {
                                <div class="mensaje error" style="margin-top:15px;">
                                    Aún quedan prerrequisitos sin cumplir que no se pudieron corregir automáticamente.
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <div class="mensaje error">
                            No se encontró una corrección automática para los prerrequisitos que fallan.
                        </div>
                    }
                }
            </div>

            @if (Model.PrimeraFormaNormal != null)
            {
                <!-- PESTAÑA: Primera Forma Normal (1FN) -->
                <div id="tab-1fn" class="seccion pestana-panel">
                    <h2>5. Primera Forma Normal (1FN)</h2>

                    <h3>Diagnóstico inicial de 1FN</h3>
                    <partial name="_TablaInforme" model="Model.PrimeraFormaNormal.EvaluacionesIniciales" />

                    @if (Model.PrimeraFormaNormal.CumpleInicialmente)
                    {
                        <div class="mensaje ok" style="margin-top:15px;">
                            Todas las tablas cumplen ya con la Primera Forma Normal (1FN): sus atributos son atómicos y no tienen grupos repetitivos.
                        </div>
                    }
                    else if (Model.PrimeraFormaNormal.HuboCambios)
                    {
                        <div class="mensaje error" style="margin-top:15px;">
                            Se detectaron violaciones a la Primera Forma Normal (1FN). El sistema descompuso y normalizó las tablas automáticamente.
                        </div>

                        <h3>Transformaciones aplicadas para 1FN</h3>
                        <div class="tabla-contenedor">
                            <table class="tabla">
                                <thead>
                                    <tr>
                                        <th>Tabla</th>
                                        <th>Regla 1FN</th>
                                        <th>Transformación realizada</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cambio in Model.PrimeraFormaNormal.Cambios)
                                    {
                                        <tr>
                                            <td>@cambio.Tabla</td>
                                            <td>@cambio.Regla</td>
                                            <td>@cambio.Descripcion</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <h3>Tablas en 1FN y sus datos (primeros 10 registros)</h3>
                    <partial name="_ListadoTablasConDatos" model="Model.PrimeraFormaNormal.Tablas1FN" />

                    <h3>Script SQL de 1FN</h3>
                    <partial name="_ScriptOculto" model="Model.PrimeraFormaNormal.Tablas1FN" view-data='new ViewDataDictionary(ViewData) { { "Id", "1fn" } }' />

                    @if (Model.PrimeraFormaNormal.HuboCambios)
                    {
                        <h3>Informe de 1FN después de la normalización</h3>
                        <partial name="_TablaInforme" model="Model.PrimeraFormaNormal.EvaluacionesFinales" />

                        @if (Model.PrimeraFormaNormal.Cumple1FN)
                        {
                            <div class="mensaje ok" style="margin-top:15px;">
                                Las tablas cumplen ahora con la Primera Forma Normal (1FN): se puede continuar con la Segunda Forma Normal (2FN).
                            </div>
                        }
                    }
                </div>

                @if (Model.SegundaFormaNormal != null)
                {
                    <!-- PESTAÑA: Segunda Forma Normal (2FN) -->
                    <div id="tab-2fn" class="seccion pestana-panel">
                        <h2>6. Segunda Forma Normal (2FN)</h2>

                        <h3>Diagnóstico inicial de 2FN</h3>
                        <partial name="_TablaInforme" model="Model.SegundaFormaNormal.EvaluacionesIniciales" />

                        @if (Model.SegundaFormaNormal.CumpleInicialmente)
                        {
                            <div class="mensaje ok" style="margin-top:15px;">
                                Todas las tablas en 1FN cumplen ya con la Segunda Forma Normal (2FN): no existen dependencias funcionales parciales sobre la clave primaria.
                            </div>
                        }
                        else if (Model.SegundaFormaNormal.HuboCambios)
                        {
                            <div class="mensaje error" style="margin-top:15px;">
                                Se detectaron dependencias funcionales parciales sobre claves primarias compuestas. El sistema descompuso las tablas automáticamente para llevarlas a 2FN.
                            </div>

                            <h3>Transformaciones aplicadas para 2FN</h3>
                            <div class="tabla-contenedor">
                                <table class="tabla">
                                    <thead>
                                        <tr>
                                            <th>Tabla</th>
                                            <th>Regla 2FN</th>
                                            <th>Transformación realizada</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var cambio in Model.SegundaFormaNormal.Cambios)
                                        {
                                            <tr>
                                                <td>@cambio.Tabla</td>
                                                <td>@cambio.Regla</td>
                                                <td>@cambio.Descripcion</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <h3>Tablas en 2FN y sus datos (primeros 10 registros)</h3>
                        <partial name="_ListadoTablasConDatos" model="Model.SegundaFormaNormal.TablasNormalizadas" />

                        <h3>Script SQL de 2FN</h3>
                        <partial name="_ScriptOculto" model="Model.SegundaFormaNormal.TablasNormalizadas" view-data='new ViewDataDictionary(ViewData) { { "Id", "2fn" } }' />

                        @if (Model.SegundaFormaNormal.HuboCambios)
                        {
                            <h3>Informe de 2FN después de la normalización</h3>
                            <partial name="_TablaInforme" model="Model.SegundaFormaNormal.EvaluacionesFinales" />

                            @if (Model.SegundaFormaNormal.CumpleFinal)
                            {
                                <div class="mensaje ok" style="margin-top:15px;">
                                    Las tablas cumplen ahora con la Segunda Forma Normal (2FN): se puede continuar con la Tercera Forma Normal (3FN).
                                </div>
                            }
                        }
                    </div>
                }

                @if (Model.TerceraFormaNormal != null)
                {
                    <!-- PESTAÑA: Tercera Forma Normal (3FN) -->
                    <div id="tab-3fn" class="seccion pestana-panel">
                        <h2>7. Tercera Forma Normal (3FN)</h2>

                        <h3>Diagnóstico inicial de 3FN</h3>
                        <partial name="_TablaInforme" model="Model.TerceraFormaNormal.EvaluacionesIniciales" />

                        @if (Model.TerceraFormaNormal.CumpleInicialmente)
                        {
                            <div class="mensaje ok" style="margin-top:15px;">
                                Todas las tablas en 2FN cumplen ya con la Tercera Forma Normal (3FN): no existen dependencias funcionales transitivas entre atributos no clave.
                            </div>
                        }
                        else if (Model.TerceraFormaNormal.HuboCambios)
                        {
                            <div class="mensaje error" style="margin-top:15px;">
                                Se detectaron dependencias funcionales transitivas entre atributos no clave. El sistema creó las tablas catálogo correspondientes para llevar el esquema a 3FN.
                            </div>

                            <h3>Transformaciones aplicadas para 3FN</h3>
                            <div class="tabla-contenedor">
                                <table class="tabla">
                                    <thead>
                                        <tr>
                                            <th>Tabla</th>
                                            <th>Regla 3FN</th>
                                            <th>Transformación realizada</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var cambio in Model.TerceraFormaNormal.Cambios)
                                        {
                                            <tr>
                                                <td>@cambio.Tabla</td>
                                                <td>@cambio.Regla</td>
                                                <td>@cambio.Descripcion</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <h3>Tablas en 3FN y sus datos (primeros 10 registros)</h3>
                        <partial name="_ListadoTablasConDatos" model="Model.TerceraFormaNormal.TablasNormalizadas" />

                        <h3>Script SQL de 3FN</h3>
                        <partial name="_ScriptOculto" model="Model.TerceraFormaNormal.TablasNormalizadas" view-data='new ViewDataDictionary(ViewData) { { "Id", "3fn" } }' />

                        @if (Model.TerceraFormaNormal.HuboCambios)
                        {
                            <h3>Informe de 3FN después de la normalización</h3>
                            <partial name="_TablaInforme" model="Model.TerceraFormaNormal.EvaluacionesFinales" />

                            @if (Model.TerceraFormaNormal.CumpleFinal)
                            {
                                <div class="mensaje ok" style="margin-top:15px;">
                                    El esquema de base de datos se encuentra completamente normalizado en Tercera Forma Normal (3FN).
                                </div>
                            }
                        }
                    </div>

                    <!-- PESTAÑA: Diagrama entidad-relación -->
                    <div id="tab-er" class="seccion pestana-panel">
                        <h2>8. Diagrama Entidad-Relación (esquema en 3FN)</h2>
                        <partial name="_DiagramaER" model="Model.TerceraFormaNormal.TablasNormalizadas" />
                    </div>
                }
            }

            <script>
                function mostrarPestana(idPanel, boton) {
                    var paneles = document.querySelectorAll('.pestana-panel');
                    for (var i = 0; i < paneles.length; i++) {
                        paneles[i].classList.remove('activa');
                    }
                    var botones = document.querySelectorAll('.pestana-btn');
                    for (var j = 0; j < botones.length; j++) {
                        botones[j].classList.remove('activa');
                    }
                    var destino = document.getElementById(idPanel);
                    if (destino) destino.classList.add('activa');
                    if (boton) boton.classList.add('activa');
                }

                function alternarScript(id, boton) {
                    var caja = document.getElementById('script-' + id);
                    var visible = caja.style.display !== 'none';
                    caja.style.display = visible ? 'none' : 'block';
                    boton.textContent = visible ? 'Mostrar script SQL' : 'Ocultar script SQL';
                }

                function copiarScript(id) {
                    var area = document.getElementById('texto-' + id);
                    area.select();
                    navigator.clipboard.writeText(area.value);
                }

                function descargarScript(id) {
                    var texto = document.getElementById('texto-' + id).value;
                    var enlace = document.createElement('a');
                    enlace.href = URL.createObjectURL(new Blob([texto], { type: 'text/plain' }));
                    enlace.download = 'script_' + id + '.sql';
                    enlace.click();
                }
            </script>
        }
    }

    <div class="pie">
        Administración de Base de Datos II
    </div>

</div>
