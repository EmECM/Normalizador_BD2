@using Normalizador.Core.Modelos
@model IEnumerable<Tabla>

@foreach (var tabla in Model)
{
    <h3>@($"{tabla.Esquema}.{tabla.Nombre}")</h3>

    <div class="tabla-contenedor">
        <table class="tabla">
            <thead>
                <tr>
                    <th>Columna</th>
                    <th>Tipo</th>
                    <th>PK</th>
                    <th>FK</th>
                    <th>Único</th>
                    <th>Acepta nulos</th>
                    <th>Identity</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var esPkCompuesta = tabla.ClavePrimaria.Count > 1;
                }
                @foreach (var c in tabla.Columnas)
                {
                    var fk = tabla.ClavesForaneas.FirstOrDefault(f =>
                        f.Columnas.Any(col => col.Equals(c.Nombre, StringComparison.OrdinalIgnoreCase)));
                    var textoFk = "";
                    if (fk != null)
                    {
                        var idx = fk.Columnas.FindIndex(col => col.Equals(c.Nombre, StringComparison.OrdinalIgnoreCase));
                        var colRef = idx >= 0 && idx < fk.ColumnasReferenciadas.Count
                            ? fk.ColumnasReferenciadas[idx]
                            : string.Join(", ", fk.ColumnasReferenciadas);
                        textoFk = $"Sí → {fk.TablaReferenciada}({colRef})";
                    }
                    var textoPk = !c.EsPrimaryKey ? "" : (esPkCompuesta ? "Sí (Compuesta)" : "Sí");
                    <tr>
                        <td>@c.Nombre</td>
                        <td>@c.TipoDato</td>
                        <td>@textoPk</td>
                        <td>@textoFk</td>
                        <td>@(c.EsUnica ? "Sí" : "")</td>
                        <td>@(c.PermiteNulos ? "Sí" : "No")</td>
                        <td>@(c.EsIdentity ? "Sí" : "")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p>
        <strong>@(esPkCompuesta ? "Clave primaria compuesta:" : "Clave primaria:")</strong>
        @string.Join(", ", tabla.ClavePrimaria.Select(c => c.Nombre))
    </p>

    @if (tabla.ClavesForaneas.Count > 0)
    {
        <p>
            <strong>Claves foráneas:</strong>
            @string.Join("; ", tabla.ClavesForaneas.Select(fk =>
                $"({string.Join(", ", fk.Columnas)}) → {fk.TablaReferenciada}({string.Join(", ", fk.ColumnasReferenciadas)})"))
        </p>
    }
}
